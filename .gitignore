# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# ── 虛擬環境 ─────────────────────────────────────────────────
.venv/

# ── 環境變數（含 API Key / DB 密碼，絕對不上傳）────────────────
.env

# ── 執行期狀態檔（程式啟動時自動建立，不需版控）────────────────
active_scrapers.json
active_llm_requests.json
active_users.json
search_logs.json
session_comparison_times.json
stage2_performance.json
user_peak.json
vector_blocking_test_results.json

# ── 爬蟲暫存資料（每次搜尋後重新產生）──────────────────────────
momo.csv
pchome.csv

# ── 除錯截圖 ─────────────────────────────────────────────────
*.png
*.jpg
*.jpeg

# ── Streamlit secrets ────────────────────────────────────────
.streamlit/secrets.toml

# ── 部署設定（含本機路徑）────────────────────────────────────
cloudflared-config.yml

# ── IDE / 系統 ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── 大型模型檔案（以 Git LFS 追蹤）──────────────────────────
models/ 目錄由 .gitattributes 設定 LFS，此處不額外排除

